          "name": "Create a thread",
          "request": {
            "name": "Create a thread",
            "description": {
              "content": "Creates a new thread in the caller's organization. Requires a user-scoped API key; org-wide API keys and M2M applications receive `403 FORBIDDEN` during beta. The `prompt` is required -- it's persisted as the first user message and triggers the assistant's response to generate asynchronously. Poll `GET /api/v1/threads/{id}` until the derived `status.state` is `idle` (or `error`).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "threads"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
